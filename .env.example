# Aplicación y sesiones SSR. Copiar los valores públicos desde `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Solo para pruebas locales aisladas. Nunca exponer la clave service role al navegador.
RUN_SUPABASE_INTEGRATION=false
SUPABASE_TEST_URL=http://127.0.0.1:54321
SUPABASE_TEST_PUBLISHABLE_KEY=replace-with-local-publishable-key
SUPABASE_TEST_SERVICE_ROLE_KEY=replace-with-local-service-role-key
TEST_BASE_URL=http://127.0.0.1:3000

