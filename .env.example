# Identificador local del único administrador. No hay valor predeterminado.
ADMIN_USERNAME=

# Generar de forma interactiva con `npm run auth:hash`.
ADMIN_PASSWORD_HASH=

# Secreto aleatorio independiente de al menos 32 bytes. No reutilizar la contraseña.
SESSION_SECRET=

# Diagnóstico opcional: INFO, OK, WARN, ERROR u OFF.
# En desarrollo el valor implícito es INFO; en producción es WARN.
APP_LOG_LEVEL=
NEXT_PUBLIC_APP_LOG_LEVEL=
