# Identificador local del único administrador. No hay valor predeterminado.
ADMIN_USERNAME=

# Generar de forma interactiva con `npm run auth:hash`.
ADMIN_PASSWORD_HASH=

# Secreto aleatorio independiente de al menos 32 bytes. No reutilizar la contraseña.
SESSION_SECRET=

# Diagnóstico opcional: INFO, OK, WARN, ERROR u OFF.
# En desarrollo el valor implícito es INFO; en producción es WARN.
APP_LOG_LEVEL=
NEXT_PUBLIC_APP_LOG_LEVEL=

# Integración de donaciones con Google Sheets. El archivo de credenciales debe
# estar fuera del repositorio y compartirse con la hoja únicamente como lector.
GOOGLE_DONATIONS_SPREADSHEET_ID=
GOOGLE_DONATIONS_SHEET_RANGE='Respuestas normalizadas'!A:J
GOOGLE_SERVICE_ACCOUNT_CREDENTIALS_FILE=

# Entre 30000 y 60000 milisegundos. El valor implícito es 45000.
GOOGLE_DONATIONS_SYNC_INTERVAL_MS=45000
